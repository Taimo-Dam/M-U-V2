<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0f172a; color: #e2e8f0; }
      .card { background: #111827; border: 1px solid #334155; border-radius: 16px; padding: 24px; max-width: 520px; text-align: center; }
      a { color: #38bdf8; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1><%= title %></h1>
      <p><%= message %></p>
      <p>API routes:</p>
      <ul>
        <li><a href="/api/songs">/api/songs</a></li>
        <li><a href="/api/artists">/api/artists</a></li>
        <li><a href="/api/albums">/api/albums</a></li>
      </ul>
    </div>
  </body>
</html>
